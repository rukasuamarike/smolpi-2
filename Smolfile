image = "debian:bookworm-slim"
workdir = "/app"
net = true

# Right-size for host running llama-server alongside.
# Memory is elastic (virtio balloon) — host backs it on demand.
# Capping at 4 GiB leaves headroom for llama-server on the host.
cpus = 2
memory = 4096

env = [
    "DEBIAN_FRONTEND=noninteractive",
    # LLM endpoint is NOT baked here — the launcher injects it: `make machine-up`
    # / `machine-run` pass `-e LLM_URL=… -e LLM_MODEL=…` (default
    # http://127.0.0.1:8080 + gemma-4; override e.g. `make machine-run LLM_PORT=1234`
    # for LMStudio). start-agent.sh also defaults them, so a bare
    # `smolvm machine create -s Smolfile` still works.
    "BROWSER_BIN=browser39",
    "WIKI_HOME=/root",
]

[dev]
volumes = [
    "./agent:/app/agent",
    "./scripts:/app/scripts:ro",
    # Writable so the agent can maintain .pi/progress.md as native text state.
    "./.pi:/app/.pi",
    # Extensions + their compat shims (run `make setup` on the host first).
    "./extensions:/app/extensions:ro",
    "./node_modules:/app/node_modules:ro",
]
